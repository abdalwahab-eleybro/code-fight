        <path d="M565 294 L565 340" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M565 340 L10 340 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
