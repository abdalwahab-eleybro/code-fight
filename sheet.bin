  <!-- 4.4 -->
  <article class="example teal">
    <div class="ex-head"><span class="ex-tag">Example 4.4</span><h3>Find All Anagrams in a String</h3><span class="lc">LeetCode 438 · Fixed Window + Freq Map</span></div>
    <p class="ex-problem">Return all start indices of <code>p</code>'s anagrams in <code>s</code>.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N · k log k) time · O(k) space</div>
<pre class="code bf-code">def findAnagrams_brute_force(s: str, p: str) -&gt; list[int]:
    n, k = len(s), len(p)
    target = sorted(p)
    res = []
    for i in range(n - k + 1):
        if sorted(s[i:i+k]) == target:
            res.append(i)
    return res</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Fixed Window + Frequency Map · O(N) time · O(1) space (26 letters)</div>
<pre class="code teal-code">from collections import Counter

def findAnagrams(s: str, p: str) -&gt; list[int]:
    left = 0
    k = len(p)
    p_count = Counter(p)
    window_count = Counter()
    res = []

    for right in range(len(s)):
        <span class="cm"># Primitive 7: Expand — add char to window map</span>
        window_count[s[right]] += 1

        <span class="cm"># Primitive 7: Fixed-size — shrink once window &gt; k</span>
        if right - left + 1 &gt; k:
            window_count[s[left]] -= 1
            if window_count[s[left]] == 0:
                del window_count[s[left]]
            left += 1

        <span class="cm"># Primitive 5: Compare window state to reference</span>
        if window_count == p_count:
            res.append(left)

    return res</pre>
