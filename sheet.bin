  <!-- PATTERN 3 -->
  <div class="page-break"></div>
  <div class="sec-head">
    <div class="sec-kicker"><span class="tri">▶</span> Backwards Write</div>
    <div class="sec-title-row">
      <span class="badge badge-amber">Pattern 3</span>
      <span class="sec-sub">Fill the output from the end — the largest values come from the extremes</span>
    </div>
  </div>
  <p style="font-size:13.8px;color:#475569;margin-bottom:22px;">
    Converging pointers on the <b>input</b> combine with a backwards-moving write pointer on the <b>output</b>. Works when the elements to place are at the boundaries.
  </p>

  <!-- 3.1 -->
  <article class="example amber">
    <div class="ex-head"><span class="ex-tag">Example 3.1</span><h3>Squares of a Sorted Array</h3><span class="lc">LeetCode 977</span></div>
    <p class="ex-problem">Given a sorted array (may contain negatives), return the squares sorted in non-decreasing order.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N log N) time · O(N) space</div>
<pre class="code bf-code">def sortedSquares_brute_force(nums: list[int]) -&gt; list[int]:
    return sorted([x * x for x in nums])</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Converging + Backwards Write · O(N) time · O(N) space</div>
<pre class="code amber-code">def sortedSquares(nums: list[int]) -&gt; list[int]:
    n = len(nums)
    res = [0] * n

    <span class="cm"># Primitive 1: Opposite pointers AND backwards write pointer</span>
    left = 0
    right = n - 1
    write = n - 1

    <span class="cm"># Primitive 2: Inclusive bound convergence loop</span>
    while left &lt;= right:
        <span class="cm"># Primitive 5: Compare square magnitudes at both ends</span>
        if abs(nums[left]) &gt; abs(nums[right]):
            <span class="cm"># Primitive 4: Write larger square to rightmost slot</span>
            res[write] = nums[left] ** 2
            left += 1
        else:
            res[write] = nums[right] ** 2
            right -= 1
        write -= 1
    return res</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Squares of a Sorted Array — Fill from the Right</div>
      <svg class="flowchart-svg" viewBox="0 0 660 352" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Squares of a Sorted Array — Fill from the Right">
        <rect x="224.9" y="10" width="210.2" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">L = 0, R = n−1, W = n−1</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">L ≤ R ?</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#d97706">Yes</text>
        <path d="M450 106 L500 106" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="88" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return res</text>
        <polygon points="330,168 450,202 330,236 210,202" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="206" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">|nums[L]| &gt; |nums[R]| ?</text>
        <path d="M330 250 L330 264" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <path d="M210 202 L160 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="196" text-anchor="middle" font-size="10.5" font-weight="800" fill="#d97706">Yes</text>
        <rect x="30" y="179" width="130" height="46" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="95" y="198" text-anchor="middle" font-size="10.5" font-weight="800" fill="#92400e" font-family="monospace">res[W] = nums[L]²</text>
        <text x="95" y="214" text-anchor="middle" font-size="10.5" font-weight="800" fill="#92400e" font-family="monospace">L++</text>
        <path d="M95 225 L95 250 L330 250" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M450 202 L500 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="196" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="179" width="130" height="46" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="565" y="198" text-anchor="middle" font-size="10.5" font-weight="800" fill="#92400e" font-family="monospace">res[W] = nums[R]²</text>
        <text x="565" y="214" text-anchor="middle" font-size="10.5" font-weight="800" fill="#92400e" font-family="monospace">R−−</text>
        <path d="M565 225 L565 250 L330 250" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <rect x="245" y="264" width="170" height="36" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="330" y="286" text-anchor="middle" font-size="11.5" font-weight="800" fill="#92400e" font-family="monospace">W−−</text>
        <path d="M330 300 L330 330" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M330 330 L10 330 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
      </svg>
    </div>
    <div class="result-pill">Result for <code>[-4,-1,0,3,10]</code>: [0, 1, 9, 16, 100]</div>
  </article>

  <!-- 3.2 -->
  <article class="example amber">
    <div class="ex-head"><span class="ex-tag">Example 3.2</span><h3>Merge Sorted Array</h3><span class="lc">LeetCode 88</span></div>
    <p class="ex-problem">Merge <code>nums2</code> into <code>nums1</code> in-place, in sorted order. <code>nums1</code> has <code>m + n</code> slots, first <code>m</code> filled, last <code>n</code> empty.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O((M+N) log(M+N)) time · O(M+N) space</div>
<pre class="code bf-code">def merge_brute_force(nums1: list[int], m: int, nums2: list[int], n: int) -&gt; None:
    combined = nums1[:m] + nums2
    combined.sort()
    for i in range(m + n):
        nums1[i] = combined[i]</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Backwards Write · O(M+N) time · O(1) space</div>
<pre class="code amber-code">def merge(nums1: list[int], m: int, nums2: list[int], n: int) -&gt; None:
    <span class="cm"># Primitive 1: Pointers at END of each valid region + write slot</span>
    i = m - 1
    j = n - 1
    write = m + n - 1

    <span class="cm"># Primitive 2: Strict bound — stop when either input exhausted</span>
    while i &gt;= 0 and j &gt;= 0:
        <span class="cm"># Primitive 5: Compare largest remaining elements</span>
        if nums1[i] &gt; nums2[j]:
            nums1[write] = nums1[i]
            i -= 1
        else:
            nums1[write] = nums2[j]
            j -= 1
        write -= 1

    <span class="cm"># Primitive 4: Drain any remaining nums2</span>
    while j &gt;= 0:
        nums1[write] = nums2[j]
        j -= 1
        write -= 1</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Merge Sorted Array — Fill nums1 from the Back</div>
      <svg class="flowchart-svg" viewBox="0 0 660 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Merge Sorted Array — Fill nums1 from the Back">
        <rect x="210" y="10" width="240" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">i = m−1, j = n−1, W = m+n−1</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">i ≥ 0 AND j ≥ 0 ?</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#d97706">Yes</text>
        <polygon points="330,168 450,202 330,236 210,202" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="206" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">nums1[i] &gt; nums2[j] ?</text>
        <path d="M210 202 L160 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="196" text-anchor="middle" font-size="10.5" font-weight="800" fill="#d97706">Yes</text>
        <rect x="30" y="179" width="130" height="46" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="95" y="198" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">nums1[W] = nums1[i]</text>
        <text x="95" y="214" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">i−−</text>
        <path d="M450 202 L500 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="196" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="179" width="130" height="46" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="565" y="198" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">nums1[W] = nums2[j]</text>
        <text x="565" y="214" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">j−−</text>
        <rect x="240" y="262" width="180" height="34" rx="9" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="330" y="283" text-anchor="middle" font-size="11.5" font-weight="800" fill="#92400e" font-family="monospace">W−−</text>
        <path d="M95 225 L95 279 L240 279" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <path d="M565 225 L565 279 L420 279" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <path d="M330 296 L330 322 L10 322 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
        <path d="M450 106 L642 106 L642 380 L330 380 L330 404" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="480" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <polygon points="330,404 450,438 330,472 210,438" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="442" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">j ≥ 0 ?</text>
        <path d="M210 438 L160 438" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="432" text-anchor="middle" font-size="10.5" font-weight="800" fill="#d97706">Yes</text>
        <rect x="30" y="415" width="130" height="46" rx="8" fill="#fef3c7" stroke="#fcd34d" stroke-width="1.4"/>
        <text x="95" y="434" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">nums1[W] = nums2[j]</text>
        <text x="95" y="450" text-anchor="middle" font-size="10" font-weight="800" fill="#92400e" font-family="monospace">j−−, W−− · repeat</text>
        <path d="M450 438 L500 438" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="432" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="420" width="130" height="36" rx="8" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="442" text-anchor="middle" font-size="11" font-weight="800" fill="#166534">Done</text>
        <text x="330" y="502" text-anchor="middle" font-size="10.5" font-weight="500" fill="#475569" font-style="italic">If j &lt; 0, the remaining nums1 elements are already in their final place.</text>
      </svg>
    </div>
    <div class="result-pill">Result for <code>nums1=[1,2,3,0,0,0], nums2=[2,5,6]</code>: [1, 2, 2, 3, 5, 6]</div>
  </article>

  <!-- GUARDED SKIPPING -->
  <div class="page-break"></div>
  <div class="sec-head">
    <div class="sec-kicker"><span class="tri">▶</span> Cross-Cutting Technique</div>
    <div class="sec-title-row">
      <span class="badge badge-rose">Guarded Skipping</span>
      <span class="sec-sub">Not a pattern — a rule that lives inside other patterns</span>
    </div>
  </div>
  <p style="font-size:13.8px;color:#475569;margin-bottom:22px;">
    Guarded skipping is the safety detail inside a converging loop. It appears in Pattern 1 (3Sum) and in any pattern that must skip invalid or duplicate elements (Valid Palindrome).
  </p>

  <div class="rule-card">
    <div class="rule-label">🔒 The Rule</div>
    <div class="rule-code">while left &lt; right and skip_condition:</div>
    <p>Every inner skipping loop <b>must</b> repeat the outer bound test. Without <code>left &lt; right</code>, the inner loop can run past valid indices and raise <code>IndexError</code>, or silently loop forever when the outer pointers have already met.</p>
  </div>

  <article class="example rose">
    <div class="ex-head"><span class="ex-tag">Example G.1</span><h3>3Sum — Duplicate Skipping</h3><span class="lc">LeetCode 15 · callback</span></div>
    <p class="ex-problem">The guard inside Pattern 1's 3Sum.</p>
<pre class="code rose-code"><span class="cm"># Inside the converging while loop, after recording a triplet</span>
while left &lt; right and nums[left] == nums[left - 1]:
    left += 1
while left &lt; right and nums[right] == nums[right + 1]:
    right -= 1</pre>
  </article>

  <article class="example rose">
    <div class="ex-head"><span class="ex-tag">Example G.2</span><h3>Valid Palindrome</h3><span class="lc">LeetCode 125</span></div>
    <p class="ex-problem">Return true if the string is a palindrome after ignoring non-alphanumeric characters and case.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N) time · O(N) space</div>
<pre class="code bf-code">def isPalindrome_brute_force(s: str) -&gt; bool:
    cleaned = [c.lower() for c in s if c.isalnum()]
    return cleaned == cleaned[::-1]</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Converging + Guarded Skipping · O(N) time · O(1) space</div>
<pre class="code rose-code">def isPalindrome(s: str) -&gt; bool:
    <span class="cm"># Primitive 1: Opposite ends initialization</span>
    left = 0
    right = len(s) - 1

    <span class="cm"># Primitive 2: Strict bound convergence loop</span>
    while left &lt; right:
        <span class="cm"># Primitive 6: Guarded skip — non-alnum from left</span>
        while left &lt; right and not s[left].isalnum():
            left += 1
        <span class="cm"># Primitive 6: Guarded skip — non-alnum from right</span>
        while left &lt; right and not s[right].isalnum():
            right -= 1

        <span class="cm"># Primitive 5: Compare case-insensitive</span>
        if s[left].lower() != s[right].lower():
            return False

        left += 1
        right -= 1
    return True</pre>
    <div class="subhead fc-rose"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Valid Palindrome — Skip, Compare, Converge</div>
      <svg class="flowchart-svg" viewBox="0 0 660 426" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Valid Palindrome — Skip, Compare, Converge">
        <rect x="250.8" y="10" width="158.4" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">L = 0, R = n − 1</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">L &lt; R ?</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#e11d48">Yes</text>
        <path d="M450 106 L500 106" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="88" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return True</text>
        <rect x="177.7" y="168" width="304.6" height="46" rx="9" fill="#ffe4e6" stroke="#e11d48" stroke-width="1.4"/>
        <text x="330" y="187" text-anchor="middle" font-size="10.5" font-weight="800" fill="#9f1239" font-family="monospace">while L &lt; R and not s[L].isalnum(): L += 1</text>
        <text x="330" y="203" text-anchor="middle" font-size="10.5" font-weight="800" fill="#9f1239" font-family="monospace">while L &lt; R and not s[R].isalnum(): R −= 1</text>
        <path d="M330 214 L330 242" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,242 450,276 330,310 210,276" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="272" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">s[L].lower() ==</text>
        <text x="330" y="288" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">s[R].lower() ?</text>
        <path d="M330 310 L330 338" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="328" text-anchor="start" font-size="10.5" font-weight="800" fill="#e11d48">Yes</text>
        <path d="M210 276 L160 276" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="270" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="30" y="258" width="130" height="36" rx="9" fill="#ffe4e6" stroke="#fda4af" stroke-width="1.4"/>
        <text x="95" y="280" text-anchor="middle" font-size="10.5" font-weight="800" fill="#9f1239">return False</text>
        <rect x="245" y="338" width="170" height="36" rx="9" fill="#ffe4e6" stroke="#e11d48" stroke-width="1.4"/>
        <text x="330" y="360" text-anchor="middle" font-size="11.5" font-weight="800" fill="#9f1239" font-family="monospace">L++ , R−−</text>
        <path d="M330 374 L330 404" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M330 404 L10 404 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
      </svg>
    </div>
    <div class="result-pill">Result: true</div>
  </article>

  <!-- PRIMITIVE 7 + PATTERN 4 -->
  <div class="page-break"></div>
  <div class="sec-head">
    <div class="sec-kicker"><span class="tri">▶</span> Foundations · The Seventh Primitive</div>
    <div class="sec-title-row">
      <span class="badge badge-teal">Primitive 7</span>
      <span class="sec-sub">Introduced here because Sliding Window depends on it</span>
    </div>
  </div>
  <p style="font-size:13.8px;color:#475569;margin-bottom:22px;">
    The first 6 primitives cover per-element mechanics. Sliding Window needs a <b>state that spans a contiguous range</b> — a sum, a set, a frequency map — updated symmetrically as the range changes.
  </p>

  <div class="prim new">
    <div class="prim-head"><div class="prim-num">07</div><h4>Window State Expand / Shrink</h4><span class="chip new-chip">O(N) aggregate · O(1)–O(k) space</span></div>
    <ul class="prim-list">
      <li><span class="k">Symmetric Pair:</span> Every element added on expand must be removable by the same rule on shrink.</li>
      <li><span class="k">Expand (driven by <code>right</code>):</span> <code>window_sum += nums[right]</code> or <code>seen.add(nums[right])</code>.</li>
      <li><span class="k">Shrink (driven by <code>left</code>):</span> <code>window_sum -= nums[left]</code> or <code>seen.remove(nums[left])</code>, then <code>left += 1</code>.</li>
      <li><span class="k">The Invariant:</span> At the top of each outer iteration, the window state reflects exactly <code>nums[left..right]</code>.</li>
      <li><span class="k">Guard the Shrink:</span> <code>while left &lt;= right and invalid_condition:</code> — same discipline as Primitive 6.</li>
      <li><span class="k">Fixed vs Variable:</span> Fixed-size shrinks exactly once per iteration; variable-size shrinks as many times as needed.</li>
    </ul>
  </div>

  <div class="sec-head" style="margin-top:34px;">
    <div class="sec-kicker"><span class="tri">▶</span> Sliding Window (Variable &amp; Fixed Size)</div>
    <div class="sec-title-row">
      <span class="badge badge-teal">Pattern 4</span>
      <span class="sec-sub">Right pointer expands, left pointer shrinks</span>
    </div>
  </div>

  <p class="bf-note" style="margin-top:-8px"><b>Heads-up:</b> the <code>set</code>, <code>dict</code> and <code>Counter</code> used by these window examples are plain tools here. Hash tables are formalized in Volume 3 (Hash Lookup).</p>

  <!-- 4.1 -->
  <article class="example teal">
    <div class="ex-head"><span class="ex-tag">Example 4.1</span><h3>Maximum Average Subarray I</h3><span class="lc">LeetCode 643 · Fixed Window</span></div>
    <p class="ex-problem">Find the contiguous subarray of length exactly <code>k</code> with the maximum average.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N·k) time · O(1) space</div>
<pre class="code bf-code">def findMaxAverage_brute_force(nums: list[int], k: int) -&gt; float:
    n = len(nums)
    best = float('-inf')
    for i in range(n - k + 1):
        window_sum = 0
        for j in range(i, i + k):
            window_sum += nums[j]
        best = max(best, window_sum / k)
    return best</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Fixed-Size Sliding Window · O(N) time · O(1) space</div>
<pre class="code teal-code">def findMaxAverage(nums: list[int], k: int) -&gt; float:
    left = 0
    window_sum = 0
    max_sum = float('-inf')

    for right in range(len(nums)):
        <span class="cm"># Primitive 7: Expand</span>
        window_sum += nums[right]

        <span class="cm"># Primitive 7: Fixed-size shrink when window reaches size k</span>
        if right - left + 1 == k:
            max_sum = max(max_sum, window_sum)
            window_sum -= nums[left]
            left += 1

    return max_sum / k</pre>
    <div class="subhead fc-teal"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Maximum Average Subarray — Fixed Window</div>
      <svg class="flowchart-svg" viewBox="0 0 660 466" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Maximum Average Subarray — Fixed Window">
        <rect x="210.1" y="10" width="239.8" height="34" rx="9" fill="#0891b2"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">left = 0, sum = 0, max = −∞</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <rect x="210" y="72" width="240" height="44" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="91" text-anchor="middle" font-size="12" font-weight="800" fill="#155e75">for right in range(n):</text>
        <text x="330" y="107" text-anchor="middle" font-size="10.5" font-weight="500" fill="#155e75">expand the window</text>
        <path d="M330 116 L330 144" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <path d="M450 94 L500 94" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="88" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0891b2">done</text>
        <rect x="500" y="71" width="130" height="46" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="90" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return</text>
        <text x="565" y="106" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">max / k</text>
        <rect x="245" y="144" width="170" height="36" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="166" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">sum += nums[right]</text>
        <path d="M330 180 L330 208" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,208 450,242 330,276 210,242" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="238" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">window size</text>
        <text x="330" y="254" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">== k ?</text>
        <path d="M330 276 L330 304" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="294" text-anchor="start" font-size="10.5" font-weight="800" fill="#0891b2">Yes</text>
        <path d="M450 242 L642 242" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="472" y="236" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="244.45" y="304" width="171.1" height="36" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="326" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">max = max(max, sum)</text>
        <path d="M330 340 L330 368" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <rect x="245" y="368" width="170" height="46" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="387" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">sum −= nums[left]</text>
        <text x="330" y="403" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">left++</text>
        <path d="M330 414 L330 444" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M642 242 L642 444" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M642 444 L10 444 L10 94 L210 94" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
      </svg>
    </div>
    <div class="result-pill">Result for <code>[1,12,-5,-6,50,3], k=4</code>: 12.75</div>
  </article>

  <!-- 4.2 -->
  <article class="example teal">
    <div class="ex-head"><span class="ex-tag">Example 4.2</span><h3>Longest Substring Without Repeating Characters</h3><span class="lc">LeetCode 3 · Variable Window</span></div>
    <p class="ex-problem">Find the length of the longest substring without repeating characters.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N³) time · O(k) space</div>
<pre class="code bf-code">def lengthOfLongestSubstring_brute_force(s: str) -&gt; int:
    n = len(s)
    best = 0
    for i in range(n):
        for j in range(i, n):
            sub = s[i:j+1]
            if len(set(sub)) == len(sub):
                best = max(best, len(sub))
    return best</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Variable Window + Set · O(N) time · O(k) space</div>
<pre class="code teal-code">def lengthOfLongestSubstring(s: str) -&gt; int:
    left = 0
    seen = set()
    max_len = 0

    for right in range(len(s)):
        <span class="cm"># Primitive 7: Shrink while duplicate exists</span>
        while s[right] in seen:
            seen.remove(s[left])
            left += 1
        <span class="cm"># Primitive 7: Expand</span>
        seen.add(s[right])
        <span class="cm"># Primitive 5: Running maximum</span>
        max_len = max(max_len, right - left + 1)

    return max_len</pre>
    <div class="subhead fc-teal"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Longest Substring — Expand, Shrink on Duplicate</div>
      <svg class="flowchart-svg" viewBox="0 0 660 392" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Longest Substring — Expand, Shrink on Duplicate">
        <rect x="206.4" y="10" width="247.2" height="34" rx="9" fill="#0891b2"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">left = 0, seen = {}, max = 0</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <rect x="210" y="72" width="240" height="44" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="91" text-anchor="middle" font-size="12" font-weight="800" fill="#155e75">for right in range(n):</text>
        <text x="330" y="107" text-anchor="middle" font-size="10.5" font-weight="500" fill="#155e75">expand the window</text>
        <path d="M330 116 L330 144" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <path d="M450 94 L500 94" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="88" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0891b2">done</text>
        <rect x="500" y="76" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="98" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return max</text>
        <polygon points="330,144 450,178 330,212 210,178" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="182" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">s[right] in seen ?</text>
        <path d="M330 212 L330 240" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="230" text-anchor="start" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <path d="M210 178 L160 178" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="172" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0891b2">Yes</text>
        <rect x="30" y="155" width="130" height="46" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="95" y="174" text-anchor="middle" font-size="9.5" font-weight="800" fill="#155e75" font-family="monospace">seen.remove(s[left])</text>
        <text x="95" y="190" text-anchor="middle" font-size="9.5" font-weight="800" fill="#155e75" font-family="monospace">left++</text>
        <path d="M95 155 L95 130 L330 130" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <rect x="245" y="240" width="170" height="36" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="262" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">seen.add(s[right])</text>
        <path d="M330 276 L330 304" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <rect x="213.4" y="304" width="233.2" height="36" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="330" y="326" text-anchor="middle" font-size="11.5" font-weight="800" fill="#155e75" font-family="monospace">max = max(max, right−left+1)</text>
        <path d="M330 340 L330 370" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M330 370 L10 370 L10 94 L210 94" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
      </svg>
    </div>
    <div class="result-pill">Result for <code>"abcabcbb"</code>: 3 → "abc"</div>
  </article>

  <!-- 4.3 -->
  <article class="example teal">
    <div class="ex-head"><span class="ex-tag">Example 4.3</span><h3>Minimum Size Subarray Sum</h3><span class="lc">LeetCode 209 · Variable Window</span></div>
    <p class="ex-problem">Return the minimal length of a contiguous subarray whose sum ≥ target. Return 0 if none exists.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N²) time · O(1) space</div>
<pre class="code bf-code">def minSubArrayLen_brute_force(target: int, nums: list[int]) -&gt; int:
    n = len(nums)
    best = float('inf')
    for i in range(n):
        running = 0
        for j in range(i, n):
            running += nums[j]
            if running &gt;= target:
                best = min(best, j - i + 1)
                break
    return best if best != float('inf') else 0</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Variable Window (Sum) · O(N) time · O(1) space</div>
<pre class="code teal-code">def minSubArrayLen(target: int, nums: list[int]) -&gt; int:
    left = 0
    window_sum = 0
    min_len = float('inf')

    for right in range(len(nums)):
        <span class="cm"># Primitive 7: Expand</span>
        window_sum += nums[right]

        <span class="cm"># Primitive 7: Shrink while window is valid</span>
        while window_sum &gt;= target:
            min_len = min(min_len, right - left + 1)
            window_sum -= nums[left]
            left += 1

    return min_len if min_len != float('inf') else 0</pre>
    <div class="subhead fc-teal"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Minimum Size Subarray — Expand, Shrink on Valid</div>
      <svg class="flowchart-svg" viewBox="0 0 660 328" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Minimum Size Subarray — Expand, Shrink on Valid">
