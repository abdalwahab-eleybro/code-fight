  <!-- 1.3 -->
  <article class="example">
    <div class="ex-head"><span class="ex-tag">Example 1.3</span><h3>Container With Most Water</h3><span class="lc">LeetCode 11</span></div>
    <p class="ex-problem">Find two heights that form a container storing the maximum amount of water.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N²) time · O(1) space</div>
<pre class="code bf-code">def maxArea_brute_force(height: list[int]) -&gt; int:
    n = len(height)
    max_water = 0
    for i in range(n):
        for j in range(i + 1, n):
            width = j - i
            h = min(height[i], height[j])
            max_water = max(max_water, width * h)
    return max_water</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Two Pointers (Greedy) · O(N) time · O(1) space</div>
<pre class="code">def maxArea(height: list[int]) -&gt; int:
    <span class="cm"># Primitive 1: Opposite ends setup</span>
    left = 0
    right = len(height) - 1

    <span class="cm"># Primitive 5: Maximum tracking state initialization</span>
    max_water = 0

    <span class="cm"># Primitive 2: Convergence loop</span>
    while left &lt; right:
        <span class="cm"># Primitive 5: Current capacity state</span>
        width = right - left
        min_h = min(height[left], height[right])
        current_water = width * min_h
        max_water = max(max_water, current_water)

        <span class="cm"># Primitive 2: Greedy — move the shorter line inward</span>
        if height[left] &lt; height[right]:
            left += 1
        else:
            right -= 1
    return max_water</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Container With Most Water — Greedy Inward</div>
      <svg class="flowchart-svg" viewBox="0 0 660 362" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Container With Most Water — Greedy Inward">
        <rect x="217.5" y="10" width="225" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">L = 0, R = n − 1, max = 0</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">L &lt; R ?</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <path d="M450 106 L500 106" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="88" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return max</text>
        <rect x="199.6" y="168" width="260.8" height="46" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="187" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">area = (R − L) · min(h[L], h[R])</text>
        <text x="330" y="203" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">max = max(max, area)</text>
        <path d="M330 214 L330 242" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,242 450,276 330,310 210,276" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="280" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">h[L] &lt; h[R] ?</text>
        <path d="M210 276 L160 276" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="270" text-anchor="middle" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <rect x="30" y="258" width="130" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="95" y="280" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">L++</text>
        <path d="M450 276 L500 276" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="270" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="258" width="130" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="565" y="280" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">R−−</text>
