  <!-- 1.4 3Sum -->
  <article class="example">
    <div class="ex-head"><span class="ex-tag">Example 1.4</span><h3>3Sum</h3><span class="lc">LeetCode 15</span></div>
    <p class="ex-problem">Return all unique triplets that sum to zero.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N³) time · O(N) space</div>
<pre class="code bf-code">def threeSum_brute_force(nums: list[int]) -&gt; list[list[int]]:
    res = set()
    n = len(nums)
    for i in range(n):
        for j in range(i + 1, n):
            for k in range(j + 1, n):
                if nums[i] + nums[j] + nums[k] == 0:
                    res.add(tuple(sorted([nums[i], nums[j], nums[k]])))
    return [list(t) for t in res]</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Sort + Converging · O(N²) time · O(1) extra space</div>
<pre class="code">def threeSum(nums: list[int]) -&gt; list[list[int]]:
    nums.sort()
    res = []
    n = len(nums)

    for i in range(n - 2):
        <span class="cm"># Primitive 6: Skip duplicate anchor values</span>
        if i &gt; 0 and nums[i] == nums[i - 1]:
            continue

        <span class="cm"># Primitive 1: Initialize converging pointers</span>
        left = i + 1
        right = n - 1

        <span class="cm"># Primitive 2: Strict bound convergence loop</span>
        while left &lt; right:
            <span class="cm"># Primitive 5: Calculate 3-sum state</span>
            total = nums[i] + nums[left] + nums[right]

            if total == 0:
                res.append([nums[i], nums[left], nums[right]])
                left += 1
                right -= 1
                <span class="cm"># Primitive 6: Guarded skipping of inner duplicates</span>
                while left &lt; right and nums[left] == nums[left - 1]:
                    left += 1
                while left &lt; right and nums[right] == nums[right + 1]:
                    right -= 1
            elif total &lt; 0:
                left += 1
            else:
                right -= 1
    return res</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">3Sum — Anchor + Converge + Skip Duplicates</div>
      <svg class="flowchart-svg" viewBox="0 0 660 610" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="3Sum — Anchor + Converge + Skip Duplicates">
        <rect x="230" y="10" width="200" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">sort(nums); i = 0</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">i &lt; n − 2 ?</text>
        <path d="M450 106 L500 106" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="88" width="130" height="36" rx="8" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="11" font-weight="800" fill="#166534">return res</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <polygon points="330,168 450,202 330,236 210,202" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="198" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">i &gt; 0 and</text>
        <text x="330" y="214" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">nums[i] == nums[i−1] ?</text>
        <path d="M450 202 L500 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="196" text-anchor="middle" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <rect x="500" y="179" width="130" height="46" rx="8" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="565" y="198" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">skip i</text>
        <text x="565" y="214" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">(continue)</text>
        <path d="M630 202 L645 202" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M330 236 L330 264" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="254" text-anchor="start" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="220" y="264" width="220" height="34" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="285" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">L = i + 1, R = n − 1</text>
        <path d="M330 298 L330 326" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,326 450,360 330,394 210,360" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="364" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">L &lt; R ?</text>
        <path d="M450 360 L500 360" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="354" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="342" width="130" height="36" rx="8" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="565" y="364" text-anchor="middle" font-size="11" font-weight="800" fill="#0f2a4a" font-family="monospace">i++</text>
        <path d="M630 360 L645 360" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M645 360 L645 58 L330 58" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4"/>
        <path d="M330 394 L330 422" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="412" text-anchor="start" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <rect x="180" y="422" width="300" height="34" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="443" text-anchor="middle" font-size="11" font-weight="800" fill="#0f2a4a" font-family="monospace">total = nums[i] + nums[L] + nums[R]</text>
        <path d="M330 456 L330 482" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <rect x="160" y="482" width="340" height="62" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="501" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">total == 0 → record, skip dups, L++, R−−</text>
        <text x="330" y="517" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">total &lt; 0  → L++</text>
        <text x="330" y="533" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">total &gt; 0  → R−−</text>
        <path d="M330 544 L330 570 L10 570 L10 360 L210 360" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
        <text x="330" y="594" text-anchor="middle" font-size="10.5" font-weight="500" fill="#475569" font-style="italic">inner loop: L, R converge · outer loop: i advances</text>
      </svg>
    </div>
    <div class="result-pill">Result for <code>[-1,0,1,2,-1,-4]</code>: [[−1,−1,2], [−1,0,1]]</div>
  </article>

  <!-- PATTERN 2 -->
  <div class="page-break"></div>
  <div class="sec-head">
    <div class="sec-kicker"><span class="tri">▶</span> Same Direction Read &amp; Write</div>
    <div class="sec-title-row">
      <span class="badge">Pattern 2</span>
      <span class="sec-sub">A reader scanning ahead, a writer building behind</span>
    </div>
  </div>
  <p style="font-size:13.8px;color:#475569;margin-bottom:22px;">
    Both pointers start at the beginning. The read pointer scans every element; the write pointer builds the valid result in-place.
  </p>

  <!-- 2.1 -->
  <article class="example">
    <div class="ex-head"><span class="ex-tag">Example 2.1</span><h3>Remove Element</h3><span class="lc">LeetCode 27</span></div>
    <p class="ex-problem">Remove all occurrences of <code>val</code> in-place; return the number of remaining elements.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N) time · O(N) space</div>
<pre class="code bf-code">def removeElement_brute_force(nums: list[int], val: int) -&gt; int:
    temp = [x for x in nums if x != val]
    for i in range(len(temp)):
        nums[i] = temp[i]
    return len(temp)</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Read &amp; Write · O(N) time · O(1) space</div>
<pre class="code">def removeElement(nums: list[int], val: int) -&gt; int:
    <span class="cm"># Primitive 1: Write pointer initialization</span>
    write = 0

    <span class="cm"># Primitive 2 &amp; 4: Read pointer scans every index</span>
    for read in range(len(nums)):
        if nums[read] != val:
            <span class="cm"># Primitive 4: In-place overwrite at write pointer</span>
            nums[write] = nums[read]
            <span class="cm"># Primitive 2 &amp; 4: Advance write pointer</span>
            write += 1

    return write</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Remove Element — Keep Non-Matching</div>
      <svg class="flowchart-svg" viewBox="0 0 660 362" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Remove Element — Keep Non-Matching">
        <rect x="239.7" y="10" width="180.6" height="34" rx="9" fill="#0f2a4a"/>
        <text x="330" y="32" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">write = 0, read = 0</text>
        <path d="M330 44 L330 72" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,72 450,106 330,140 210,106" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="110" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">read &lt; n ?</text>
        <path d="M330 140 L330 168" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="158" text-anchor="start" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <path d="M450 106 L500 106" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="100" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="88" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return write</text>
        <polygon points="330,168 450,202 330,236 210,202" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="206" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">nums[read] != val ?</text>
        <path d="M330 236 L330 264" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="339" y="254" text-anchor="start" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <path d="M450 202 L500 202" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="475" y="196" text-anchor="middle" font-size="10.5" font-weight="700" fill="#94a3b8">No</text>
        <rect x="500" y="184" width="130" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="565" y="206" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">skip</text>
        <rect x="227.2" y="264" width="205.6" height="46" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="283" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">nums[write] = nums[read]</text>
        <text x="330" y="299" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">write++</text>
        <path d="M330 310 L330 340" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M565 220 L565 340" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M565 340 L10 340 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
      </svg>
    </div>
    <div class="result-pill">Result for <code>[3,2,2,3]</code>, val=3: 2 → [2, 2]</div>
  </article>

  <!-- 2.2 -->
  <article class="example">
    <div class="ex-head"><span class="ex-tag">Example 2.2</span><h3>Remove Duplicates from Sorted Array</h3><span class="lc">LeetCode 26</span></div>
    <p class="ex-problem">Remove duplicates in-place; return unique count.</p>
    <div class="subhead bf"><span class="dot"></span> Brute Force · O(N log N) time · O(N) space</div>
<pre class="code bf-code">def removeDuplicates_brute_force(nums: list[int]) -&gt; int:
    unique = sorted(set(nums))
    for i in range(len(unique)):
        nums[i] = unique[i]
    return len(unique)</pre>
    <div class="subhead opt"><span class="dot"></span> Optimal — Slow / Fast · O(N) time · O(1) space</div>
<pre class="code">def removeDuplicates(nums: list[int]) -&gt; int:
    if not nums:                <span class="cm"># Primitive 1: Safety bounds guard</span>
        return 0

    slow = 0
    for fast in range(1, len(nums)):
        if nums[fast] != nums[slow]:
            slow += 1
            nums[slow] = nums[fast]
    return slow + 1</pre>
    <div class="subhead fc"><span class="dot"></span> Algorithm Flowchart</div>
    <div class="flowchart-wrap">
      <div class="flowchart-title">Remove Duplicates — Compare Ahead</div>
