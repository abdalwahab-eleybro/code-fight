      <div class="col"><div class="pslot"></div><div class="cell i">2</div><div class="idx">3</div></div>
      <div class="col" style="width:22px"></div>
      <div class="col"><div class="pslot"><span class="ptr purple">j</span></div><div class="cell i">2</div><div class="idx">0</div></div>
