        <path d="M210 242 L160 242" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="236" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0891b2">Yes</text>
        <rect x="30" y="211" width="130" height="62" rx="9" fill="#cffafe" stroke="#67e8f9" stroke-width="1.4"/>
        <text x="95" y="230" text-anchor="middle" font-size="10.5" font-weight="800" fill="#155e75" font-family="monospace">record min length</text>
        <text x="95" y="246" text-anchor="middle" font-size="10.5" font-weight="800" fill="#155e75" font-family="monospace">sum −= nums[left]</text>
        <text x="95" y="262" text-anchor="middle" font-size="10.5" font-weight="800" fill="#155e75" font-family="monospace">left++</text>
        <path d="M95 211 L95 194 L330 194" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
