<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LeetCode Foundations — Volume 1 (Final): 8 Primitives, 7 Patterns &amp; Guarded Skipping</title>
<style>
  :root{
    --navy:#0f2a4a; --navy-2:#1e3a5f;
    --blue:#2563eb; --blue-soft:#e8f0fb; --blue-line:#c7d2e0;
    --green:#16a34a; --green-soft:#d9f0dc; --green-line:#7cc48a;
    --amber:#d97706; --amber-soft:#fef3c7; --amber-line:#fcd34d;
    --red:#d64545;
    --purple:#7c3aed; --purple-soft:#ede9fe; --purple-line:#c4b5fd; --purple-deep:#6b21a8;
    --teal:#0891b2; --teal-soft:#cffafe; --teal-line:#67e8f9; --teal-deep:#155e75;
    --rose:#e11d48; --rose-soft:#ffe4e6; --rose-line:#fda4af; --rose-deep:#9f1239;
    --indigo:#4338ca; --indigo-soft:#e0e7ff; --indigo-line:#a5b4fc; --indigo-deep:#312e81;
    --ink:#1e293b; --muted:#475569; --line:#e2e8f0;
  }
  *{ box-sizing:border-box; }
  html{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,"Helvetica Neue",Arial,sans-serif;
    color:var(--ink); line-height:1.62; margin:0; background:#eef2f7; font-size:14px;
  }
  .page{ max-width:920px; margin:0 auto; background:#fff; padding:52px 56px 64px; box-shadow:0 0 50px rgba(15,42,74,.10); }
  h1,h2,h3,h4{ margin:0; line-height:1.25; color:var(--navy); }
  p{ margin:0 0 12px; }
  code{ font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; background:#eef2f7; border:1px solid var(--line); border-radius:5px; padding:1px 5px; font-size:12.5px; color:var(--navy-2); }

  /* COVER */
  .cover{ text-align:center; padding:26px 0 34px; border-bottom:3px solid var(--navy); margin-bottom:34px; }
  .cover-eyebrow{ display:inline-block; font-size:11px; font-weight:800; letter-spacing:2.4px; color:#5b7a9e; text-transform:uppercase; margin-bottom:16px; }
  .cover h1{ font-size:42px; letter-spacing:-1.2px; font-weight:800; margin-bottom:6px; }
  .cover h2{ font-size:18px; font-weight:600; color:#5b7a9e; letter-spacing:-.2px; margin-bottom:16px; }
  .cover-sub{ color:var(--muted); font-size:13.5px; letter-spacing:.2px; }
  .cover-viz{ margin:26px 0 30px; }
  .cover-meta{ display:flex; justify-content:center; gap:0; flex-wrap:wrap; margin-top:26px; border-top:1px solid var(--line); padding-top:22px; }
  .cover-meta div{ padding:0 22px; border-right:1px solid var(--line); text-align:center; }
  .cover-meta div:last-child{ border-right:none; }
  .cover-meta strong{ display:block; font-size:24px; font-weight:800; color:var(--navy); letter-spacing:-.5px; line-height:1.1; }
  .cover-meta span{ font-size:10px; letter-spacing:1.1px; text-transform:uppercase; color:#5b7a9e; font-weight:700; }

  /* CALLOUT */
  .callout{ background:linear-gradient(180deg,#f4f8ff 0%,#eef4fd 100%); border:1px solid #d8e4f5; border-left:5px solid var(--blue); border-radius:12px; padding:20px 24px; margin:0 0 34px; }
  .callout .ctitle{ font-size:11px; font-weight:800; letter-spacing:1.6px; text-transform:uppercase; color:var(--blue); margin-bottom:8px; }
  .callout p{ margin:0; color:#33506e; font-size:14px; }
  .callout p + p{ margin-top:8px; }

  /* SECTION HEADINGS */
  .sec-head{ margin:0 0 26px; }
  .sec-kicker{ display:flex; align-items:center; gap:9px; font-size:11.5px; font-weight:800; letter-spacing:1.8px; color:#5b7a9e; text-transform:uppercase; margin-bottom:12px; }
  .sec-kicker .tri{ color:#7d93ad; font-size:9px; }
  .sec-title-row{ display:flex; align-items:center; flex-wrap:wrap; gap:14px; }
  .badge{ display:inline-block; background:var(--navy); color:#fff; font-size:11.5px; font-weight:800; letter-spacing:1.4px; padding:8px 18px; border-radius:999px; box-shadow:0 3px 0 rgba(15,42,74,.18); text-transform:uppercase; }
  .badge.badge-teal{ background:var(--teal); box-shadow:0 3px 0 rgba(8,145,178,.25); }
  .badge.badge-amber{ background:var(--amber); box-shadow:0 3px 0 rgba(217,119,6,.25); }
  .badge.badge-indigo{ background:var(--indigo); box-shadow:0 3px 0 rgba(67,56,202,.25); }
  .badge.badge-purple{ background:var(--purple); box-shadow:0 3px 0 rgba(124,58,237,.25); }
  .badge.badge-rose{ background:#fff; color:var(--rose); border:2px dashed var(--rose); box-shadow:none; padding:6px 16px; }
  .sec-sub{ font-style:italic; color:#5b7a9e; font-size:15px; }

  /* PRIMITIVES */
  .prim{ border:1px solid var(--line); border-radius:14px; padding:20px 24px; margin-bottom:16px; background:#fff; break-inside:avoid; }
  .prim.new{ border-color:var(--teal-line); background:linear-gradient(180deg,#f0fdff 0%,#fff 100%); }
  .prim.new-indigo{ border-color:var(--indigo-line); background:linear-gradient(180deg,#f5f3ff 0%,#fff 100%); }
  .prim-head{ display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:12px; }
  .prim-num{ flex:0 0 auto; width:38px; height:38px; border-radius:11px; background:var(--navy); color:#fff; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:800; letter-spacing:.5px; }
  .prim.new .prim-num{ background:var(--teal); }
  .prim.new-indigo .prim-num{ background:var(--indigo); }
  .prim-head h4{ font-size:16.5px; font-weight:800; letter-spacing:-.2px; flex:1 1 auto; }
  .chip{ font-size:10.5px; font-weight:800; letter-spacing:.9px; text-transform:uppercase; color:var(--green); background:var(--green-soft); border:1px solid var(--green-line); border-radius:999px; padding:4px 12px; white-space:nowrap; }
  .chip.new-chip{ color:var(--teal-deep); background:var(--teal-soft); border-color:var(--teal-line); }
  .chip.new-chip-indigo{ color:var(--indigo-deep); background:var(--indigo-soft); border-color:var(--indigo-line); }
  ul.prim-list{ margin:0; padding-left:0; list-style:none; }
  ul.prim-list li{ position:relative; padding-left:20px; margin-bottom:8px; font-size:13.5px; color:#334155; }
  ul.prim-list li:last-child{ margin-bottom:0; }
  ul.prim-list li::before{ content:""; position:absolute; left:2px; top:9px; width:6px; height:6px; border-radius:50%; background:var(--blue); }
  .prim.new ul.prim-list li::before{ background:var(--teal); }
  .prim.new-indigo ul.prim-list li::before{ background:var(--indigo); }
  ul.prim-list li .k{ font-weight:800; color:var(--navy); }

  /* VIZ */
  .viz{ display:flex; justify-content:center; align-items:flex-start; gap:6px; margin:22px 0; flex-wrap:nowrap; }
  .viz.wrap{ flex-wrap:wrap; }
  .col{ display:flex; flex-direction:column; align-items:center; gap:5px; }
  .pslot{ height:20px; display:flex; align-items:flex-end; justify-content:center; font-size:12.5px; font-weight:900; letter-spacing:.6px; }
  .ptr{ color:var(--red); } .ptr.green{ color:var(--green); } .ptr.blue{ color:var(--blue); }
  .ptr.amber{ color:var(--amber); } .ptr.teal{ color:var(--teal); } .ptr.meet{ color:var(--navy); }
  .ptr.indigo{ color:var(--indigo); } .ptr.purple{ color:var(--purple); }
  .cell{ width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; border:1.6px solid var(--blue-line); background:var(--blue-soft); font-weight:800; font-size:15.5px; color:var(--navy-2); font-variant-numeric:tabular-nums; }
  .cell.g{ background:var(--green-soft); border-color:var(--green-line); }
  .cell.a{ background:var(--amber-soft); border-color:var(--amber-line); }
  .cell.t{ background:var(--teal-soft); border-color:var(--teal-line); }
  .cell.i{ background:var(--indigo-soft); border-color:var(--indigo-line); color:var(--indigo-deep); }
  .cell.done{ background:var(--purple-soft); border-color:var(--purple-line); color:var(--purple-deep); position:relative; }
  .cell.done::after{ content:"✓"; position:absolute; top:-5px; right:-5px; width:16px; height:16px; border-radius:50%; background:var(--purple); color:#fff; font-size:9px; font-weight:900; display:flex; align-items:center; justify-content:center; }
  .idx{ font-size:11px; color:#5b7a9e; font-weight:700; font-variant-numeric:tabular-nums; }
  .viz-label{ text-align:center; font-size:11px; font-weight:800; letter-spacing:1.3px; text-transform:uppercase; color:var(--navy-2); margin:0 0 6px; }
  .viz-caption{ text-align:center; font-size:12.5px; color:#475569; font-style:italic; margin:-14px 0 22px; }

  /* FLOWCHART */
  .flowchart-wrap{ background:#f8fafc; border:1px solid var(--line); border-radius:14px; padding:20px 12px 14px; margin:0 0 22px; text-align:center; break-inside:avoid; }
  .flowchart-title{ font-size:11px; font-weight:800; letter-spacing:1.6px; text-transform:uppercase; color:var(--navy-2); margin-bottom:8px; }
  .flowchart-svg{ width:100%; max-width:600px; height:auto; display:inline-block; }
  .flowchart-svg text{ font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,sans-serif; }
  .flowchart-wrap.wide .flowchart-svg{ max-width:740px; }

  /* EXAMPLE */
  .example{ border:1px solid var(--line); border-radius:14px; padding:24px 26px; margin:0 0 26px; background:#fff; break-inside:avoid; }
  .example.teal{ border-left:4px solid var(--teal); }
  .example.rose{ border-left:4px solid var(--rose); }
  .example.amber{ border-left:4px solid var(--amber); }
  .example.indigo{ border-left:4px solid var(--indigo); }
  .example.purple{ border-left:4px solid var(--purple); }
  .ex-head{ display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; border-bottom:1px solid var(--line); padding-bottom:12px; margin-bottom:16px; }
  .ex-tag{ font-size:10.5px; font-weight:800; letter-spacing:1.3px; text-transform:uppercase; color:#fff; background:var(--navy); border-radius:6px; padding:4px 10px; position:relative; top:-2px; }
  .example.teal .ex-tag{ background:var(--teal); }
  .example.rose .ex-tag{ background:var(--rose); }
  .example.amber .ex-tag{ background:var(--amber); }
  .example.indigo .ex-tag{ background:var(--indigo); }
  .example.purple .ex-tag{ background:var(--purple); }
  .ex-head h3{ font-size:18.5px; font-weight:800; letter-spacing:-.3px; flex:1 1 auto; }
  .lc{ font-size:11px; font-weight:800; letter-spacing:.8px; color:var(--blue); background:var(--blue-soft); border:1px solid #cfe0f7; border-radius:999px; padding:3px 11px; white-space:nowrap; }
  .ex-problem{ font-size:13.5px; color:#475569; margin-bottom:18px; }

  .subhead{ display:flex; align-items:center; gap:9px; font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; margin:20px 0 10px; }
  .subhead .dot{ width:8px; height:8px; border-radius:50%; flex:0 0 auto; }
  .subhead.bf{ color:#b45309; } .subhead.bf .dot{ background:#f59e0b; }
  .subhead.opt{ color:var(--green); } .subhead.opt .dot{ background:var(--green); }
  .subhead.fc{ color:var(--blue); } .subhead.fc .dot{ background:var(--blue); }
  .subhead.fc-teal{ color:var(--teal); } .subhead.fc-teal .dot{ background:var(--teal); }
  .subhead.fc-rose{ color:var(--rose); } .subhead.fc-rose .dot{ background:var(--rose); }
  .subhead.fc-indigo{ color:var(--indigo); } .subhead.fc-indigo .dot{ background:var(--indigo); }
  .subhead.fc-purple{ color:var(--purple); } .subhead.fc-purple .dot{ background:var(--purple); }

  .bf-note{ font-size:13.5px; color:#475569; margin:0 0 12px; }
  .bf-note b{ color:#b45309; }

  /* CODE */
  pre.code{ background:#f7f9fc; border:1px solid #e2e8f0; border-left:4px solid var(--blue); border-radius:10px; padding:16px 18px; margin:0 0 16px; font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; font-size:12.3px; line-height:1.62; color:#1e293b; overflow-x:auto; white-space:pre; break-inside:avoid; }
  pre.code.bf-code{ border-left-color:#f59e0b; background:#fffdf5; }
  pre.code.teal-code{ border-left-color:var(--teal); background:#f0fdff; }
  pre.code.rose-code{ border-left-color:var(--rose); background:#fff5f7; }
  pre.code.amber-code{ border-left-color:var(--amber); background:#fffdf5; }
  pre.code.indigo-code{ border-left-color:var(--indigo); background:#f5f3ff; }
  pre.code.purple-code{ border-left-color:var(--purple); background:#faf5ff; }
  pre.code .cm{ color:#15803d; font-style:italic; }
  pre.code .kw{ color:#7c3aed; font-weight:600; }
  pre.code .st{ color:#b45309; }

  .result-pill{ display:inline-block; margin-top:8px; background:var(--green-soft); border:1px solid var(--green-line); color:#166534; font-weight:800; font-size:13px; border-radius:8px; padding:8px 18px; }

  /* RULE CARD */
  .rule-card{ background:linear-gradient(180deg,#fff5f7 0%,#fff 100%); border:1px solid var(--rose-line); border-left:5px solid var(--rose); border-radius:12px; padding:20px 24px; margin:0 0 20px; }
  .rule-card .rule-label{ font-size:10.5px; font-weight:800; letter-spacing:1.6px; text-transform:uppercase; color:var(--rose); margin-bottom:10px; }
  .rule-card .rule-code{ background:#fff; border:1px solid var(--rose-line); border-radius:8px; padding:12px 16px; font-family:"SFMono-Regular",Consolas,Menlo,monospace; font-size:12.5px; color:var(--rose-deep); font-weight:600; margin-bottom:10px; }
  .rule-card p{ margin:0; font-size:13.5px; color:#5b3a44; }

  /* TABLE */
  table.matrix{ width:100%; border-collapse:separate; border-spacing:0; font-size:12.5px; border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:26px; break-inside:avoid; }
  table.matrix th{ background:var(--navy); color:#fff; font-size:10.5px; letter-spacing:1.1px; text-transform:uppercase; font-weight:800; text-align:left; padding:11px 12px; }
  table.matrix td{ padding:11px 12px; border-bottom:1px solid var(--line); vertical-align:top; color:#334155; }
  table.matrix tr:last-child td{ border-bottom:none; }
  table.matrix tr:nth-child(even) td{ background:#fafcff; }
  table.matrix td strong{ color:var(--navy); }
  table.matrix .mono{ font-family:"SFMono-Regular",Consolas,Menlo,monospace; font-size:11.3px; color:#475569; line-height:1.7; }
  .tag-green{ color:var(--green); font-weight:800; }
  .tag-blue{ color:var(--blue); font-weight:800; }
  .tag-teal{ color:var(--teal); font-weight:800; }
  .tag-amber{ color:var(--amber); font-weight:800; }
  .tag-rose{ color:var(--rose); font-weight:800; }
  .tag-indigo{ color:var(--indigo); font-weight:800; }
  .tag-purple{ color:var(--purple); font-weight:800; }

  /* ROADMAP TABLE */
  table.roadmap{ width:100%; border-collapse:separate; border-spacing:0; font-size:12.3px; border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:26px; break-inside:avoid; }
  table.roadmap th{ background:linear-gradient(90deg,#0f2a4a 0%,#1e3a5f 100%); color:#fff; font-size:10.5px; letter-spacing:1.1px; text-transform:uppercase; font-weight:800; text-align:left; padding:12px 12px; }
  table.roadmap td{ padding:11px 12px; border-bottom:1px solid var(--line); vertical-align:top; color:#334155; }
  table.roadmap tr:last-child td{ border-bottom:none; }
  table.roadmap tr:nth-child(even) td{ background:#fafcff; }
  table.roadmap tr.current td{ background:linear-gradient(180deg,#fff7ed 0%,#fffdf5 100%); border-left:3px solid var(--amber); }
  table.roadmap tr.current td:first-child{ padding-left:9px; }
  table.roadmap td strong{ color:var(--navy); }
  table.roadmap .volnum{ display:inline-block; background:var(--navy); color:#fff; font-weight:900; font-size:11px; padding:2px 8px; border-radius:6px; letter-spacing:.8px; }
  table.roadmap tr.current .volnum{ background:var(--amber); }
  table.roadmap .voltitle{ font-weight:800; color:var(--navy); font-size:13px; display:block; margin-top:3px; }
  table.roadmap .patterns-list{ font-size:11.8px; color:#475569; line-height:1.65; }
  table.roadmap .status{ font-size:10.5px; font-weight:800; letter-spacing:.6px; text-transform:uppercase; }
  table.roadmap .status.shipped{ color:var(--green); }
  table.roadmap .status.next{ color:var(--amber); }
  table.roadmap .status.planned{ color:#94a3b8; }

  /* BUGS */
  .bug{ display:flex; gap:16px; border:1px solid var(--line); border-left:5px solid #ef4444; border-radius:12px; padding:16px 20px; margin-bottom:12px; background:#fff; break-inside:avoid; }
  .bug-num{ flex:0 0 auto; width:32px; height:32px; border-radius:9px; background:#fee2e2; color:#b91c1c; font-weight:900; font-size:14px; display:flex; align-items:center; justify-content:center; }
  .bug-body h5{ margin:0 0 4px; font-size:14.5px; font-weight:800; color:var(--navy); }
  .bug-body p{ margin:0; font-size:13.2px; color:#475569; }

  /* FOOTER */
  .doc-footer{ margin-top:44px; padding-top:18px; border-top:1px solid var(--line); text-align:center; font-size:11px; letter-spacing:1.2px; text-transform:uppercase; color:#5b7a9e; font-weight:700; }

  /* PRINT */
  .cb{ display:inline-block; width:10px; height:10px; border:1.4px solid #64748b; border-radius:2px; margin-right:6px; vertical-align:-1px; background:#fff; }
  td.ck{ font-size:11.8px; line-height:1.75; }
  table.ladder td, table.cov td{ padding-top:8px; padding-bottom:8px; }
  table.cov td{ font-size:11.8px; line-height:1.6; }
  .chk-grid{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:6px 22px; }
  .chk-item{ font-size:12.3px; color:#334155; line-height:1.5; break-inside:avoid; }
  .practice{ font-style:italic; color:var(--muted); font-size:11px; }
  .print-tip{ background:#fff7ed; border:1px solid #fcd34d; border-radius:10px; padding:10px 16px; font-size:12.5px; color:#92400e; margin:0 0 22px; }
  .tpl-grid{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:14px 16px; margin-top:6px; }
  .tpl{ break-inside:avoid; min-width:0; }
  .tpl-h{ font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:var(--navy-2,#1e3a5f); margin-bottom:5px; }
  .tpl pre.code{ margin:0; font-size:11.5px; padding:10px 12px; overflow:hidden; }
  .tpl-intro{ font-size:13.5px; color:var(--muted); margin:0 0 14px; }

  /* PRINT */
  @page{ size:A4; margin:12mm 10mm 15mm;
    @bottom-center{ content:"LeetCode Foundations \00B7 Volume 1 \00B7 Page " counter(page) " of " counter(pages); font-size:8px; color:#5b7a9e; letter-spacing:.8px; } }
  @media print{
    .print-tip{ display:none; }
    .example{ break-inside:auto; padding-top:16px; padding-bottom:10px; margin-bottom:14px; }
    .viz{ margin-top:6px; margin-bottom:6px; }
    .ex-head, .subhead, .viz-label, .sec-head, .flowchart-title{ break-after:avoid; }
    .viz, .result-pill{ break-inside:avoid; }
    .prim{ padding:9px 16px; margin-bottom:7px; }
    .prim-head{ margin-bottom:6px; gap:10px; }
    .prim-num{ width:32px; height:32px; }
    .prim ul.prim-list li{ margin-bottom:2px; line-height:1.4; }
    .sec-head{ margin-bottom:16px; }
    .flowchart-svg{ max-width:470px; }
    .flowchart-wrap{ break-after:avoid; padding:14px 10px 10px; margin-bottom:12px; }
    .flowchart-wrap.wide .flowchart-svg{ max-width:640px; }
    .result-pill{ break-before:avoid; }
    .tpl pre.code{ font-size:9.6px; }
    body{ background:#fff; font-size:12px; }
    .page{ box-shadow:none; margin:0; max-width:none; padding:0; }
    .page-break{ page-break-before:always; }
    .cover{ padding-top:0; }
    .prim, table.roadmap, .bug, .flowchart-wrap, .rule-card{ break-inside:avoid; }
    table.matrix{ break-inside:auto; }
    table.matrix thead{ display:table-header-group; }
    table.matrix tr{ break-inside:avoid; }
    table.matrix th, table.matrix td{ padding:7px 10px; }
    table.ladder td, table.cov td{ padding-top:5px; padding-bottom:5px; }
    .ex-head{ break-inside:avoid; }
    .callout{ break-inside:avoid; }
    table.cov td{ font-size:10.8px; line-height:1.5; padding-top:4px; padding-bottom:4px; }
    .doc-footer{ margin-top:8px; padding-top:8px; break-before:avoid; }
    .chk-grid{ gap:3px 18px; }
    pre.code{ font-size:10.6px; }
    .cell{ width:40px; height:40px; font-size:13px; }
    a{ text-decoration:none; color:inherit; }
  }
  @media (max-width:640px){
    .page{ padding:26px 20px 40px; }
    .cover h1{ font-size:30px; }
    .cell{ width:36px; height:36px; font-size:12.5px; }
    .viz{ gap:4px; }
  }
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <marker id="ar" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/></marker>
