        <path d="M95 219 L95 194 L330 194" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <rect x="223.75" y="304" width="212.5" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="326" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">candidate = s[l+1 .. r−1]</text>
        <path d="M330 340 L330 368" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
