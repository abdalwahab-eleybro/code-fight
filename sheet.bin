        <text x="565" y="106" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">s[best]</text>
        <rect x="245" y="144" width="170" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="166" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">l, r = center</text>
