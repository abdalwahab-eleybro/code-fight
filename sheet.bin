        <path d="M565 241 L565 271" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
        <path d="M565 271 L10 271 L10 106 L210 106" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#ar)"/>
