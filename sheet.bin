        <text x="185" y="260" text-anchor="middle" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <rect x="30" y="243" width="130" height="46" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="95" y="262" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return</text>
        <text x="95" y="278" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">[L+1, R+1]</text>
        <polygon points="330,328 450,362 330,396 210,362" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
        <text x="330" y="366" text-anchor="middle" font-size="12" font-weight="800" fill="#b45309">sum &lt; target ?</text>
        <path d="M210 362 L160 362" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <text x="185" y="356" text-anchor="middle" font-size="10.5" font-weight="800" fill="#2563eb">Yes</text>
        <rect x="30" y="344" width="130" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="95" y="366" text-anchor="middle" font-size="10.5" font-weight="800" fill="#0f2a4a" font-family="monospace">L++</text>
