        <rect x="500" y="88" width="130" height="36" rx="9" fill="#d9f0dc" stroke="#7cc48a" stroke-width="1.4"/>
        <text x="565" y="110" text-anchor="middle" font-size="10.5" font-weight="800" fill="#166534">return []</text>
        <rect x="230.65" y="168" width="198.7" height="36" rx="9" fill="#e8f0fb" stroke="#2563eb" stroke-width="1.4"/>
        <text x="330" y="190" text-anchor="middle" font-size="11.5" font-weight="800" fill="#0f2a4a" font-family="monospace">sum = nums[L] + nums[R]</text>
        <path d="M330 204 L330 232" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ar)"/>
        <polygon points="330,232 450,266 330,300 210,266" fill="#fff7ed" stroke="#f59e0b" stroke-width="1.6"/>
